# Backend API base URL (server-side), including /api
API_URL=http://localhost:8080/api

# Admin login: the only password that unlocks /admin
ADMIN_PASSWORD=choose-a-strong-password

# Signs the admin token cookie; must match the backend's ADMIN_TOKEN_SECRET (min 32 chars)
ADMIN_TOKEN_SECRET=generate-a-random-string-of-at-least-32-characters

# Cloudflare Turnstile (public site key)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
