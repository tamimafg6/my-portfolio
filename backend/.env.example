# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio

# Auth (JWT from auth-service)
JWT_SECRET=your-jwt-secret
# or AUTH_JWT_SECRET=your-jwt-secret

# DigitalOcean Spaces (resume + profile photo)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_ACCESS_KEY_ID=your-spaces-key
DO_SPACES_SECRET_ACCESS_KEY=your-spaces-secret
# Optional: CDN URL for faster public URLs
# DO_SPACES_CDN_URL=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
