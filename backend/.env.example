# Database (Supabase Postgres)
# Use the transaction pooler (port 6543) for the deployed app
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared with the frontend: verifies the admin token issued at login (min 32 chars)
ADMIN_TOKEN_SECRET=generate-a-random-string-of-at-least-32-characters

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile (contact + testimonial forms)
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret

# Supabase Storage (S3-compatible) for resume + profile photo
# Keys: Supabase dashboard > Storage > S3 Configuration > New access key
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=<project-region>
STORAGE_BUCKET=portfolio
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
